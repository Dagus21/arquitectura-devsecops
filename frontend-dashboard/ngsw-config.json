{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*"
        ]
      }
    }
  ],
  
  "dataGroups": [
    {
      "name": "api-data",
      "urls": [
        "/api/productos/**", 
        "/api/ventas/**",
        "/api/usuarios/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 0, 
        "maxAge": "0u", 
        "timeout": "2s"
      }
    }
  ],
  "navigationRequestStrategy": "freshness" 
}
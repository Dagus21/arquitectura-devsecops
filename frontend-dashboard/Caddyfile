:80 {
    # Establece la carpeta raíz donde están los archivos
    root * /usr/share/caddy

    # Habilita la compresión para que el sitio cargue más rápido
    encode gzip

    # Sirve los archivos estáticos
    file_server

    # Esta es la regla mágica para las SPAs (Angular/React/Vue):
    # Si Caddy no encuentra un archivo que coincida con la URL
    # (por ejemplo, /dashboard/usuarios), en lugar de dar un error 404,
    # simplemente devuelve el archivo index.html.
    # Esto permite que el enrutador de Angular tome el control.
    try_files {path} /index.html
}
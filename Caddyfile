# Caddyfile Principal - Versión Final Corregida

:80 {
    route {
        # 1. Rutas para la API
        handle /api* {
            reverse_proxy backend:8080
        }

        # 2. Rutas para el Dashboard (Esta es TU versión, la correcta)
        handle /dashboard* {
            uri strip_prefix /dashboard
            reverse_proxy frontend-dashboard:80
        }

        # 3. Rutas para todo lo demás (E-commerce)
        handle {
            reverse_proxy frontend-ecommerce:80
        }
    }
}

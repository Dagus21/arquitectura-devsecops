# Caddyfile Final con Ruta para el Dashboard

miscelaneasdavid.shop {
    encode gzip

    # Regla 1: Rutas para la API (la más específica primero)
    # ej: https://miscelaneasdavid.shop/api/...
    handle /api* {
        reverse_proxy backend:8080
    }

    # Regla 2: Rutas para el Dashboard
    # ej: https://miscelaneasdavid.shop/dashboard/...
    handle /dashboard* {
        # Esta directiva es clave: quita /dashboard de la URL antes de pasarla al contenedor.
        # Así, el contenedor de Angular recibe una petición para "/" en lugar de "/dashboard".
        uri strip_prefix /dashboard
        reverse_proxy frontend-dashboard:80
    }

    # Regla 3: Todo lo demás va al E-commerce (la regla "catch-all")
    handle {
        reverse_proxy frontend-ecommerce:80
    }
}

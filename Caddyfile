:80 {
    route {
        # Usamos un comodín (*) para hacer la coincidencia más flexible
        handle /api* {
            reverse_proxy backend:8080
        }

        # Usamos un comodín (*) para hacer la coincidencia más flexible
        handle /dashboard* {
            uri strip_prefix /dashboard
            reverse_proxy frontend-dashboard:80
        }

        handle {
            reverse_proxy frontend-ecommerce:80
        }
    }
}

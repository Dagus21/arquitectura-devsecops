:80 {
    # El bloque 'route' le dice a Caddy que evalúe estas reglas en orden estricto.
    route {
        # 1. Si la ruta empieza con /api/, envíala al backend y detén el procesamiento.
        handle /api/* {
            reverse_proxy backend:8080
        }

        # 2. Si la ruta empieza con /dashboard/, envíala al dashboard y detén el procesamiento.
        handle /dashboard/* {
            reverse_proxy frontend-dashboard:80
        }

        # 3. Si ninguna de las reglas anteriores coincidió, envía todo lo demás al e-commerce.
        handle {
            reverse_proxy frontend-ecommerce:80
        }
    }
}